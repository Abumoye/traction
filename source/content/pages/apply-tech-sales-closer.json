    "sub": "We are hiring a Tech Sales Closer for our sales team. Remote · ₦100,000/month plus uncapped commission."
  },
  "sections": [
    {
      "type": "grid",
      "tight": true,
      "columns": 4,
      "style": "icon-list",
      "entries": [
        {
          "icon": "fa-map-marker-alt",
          "title": "Remote, open to applicants in Nigeria",
          "text": ""
        },
        {
          "icon": "fa-laptop",
          "title": "Remote Role",
          "text": ""
        },
        {
          "icon": "fa-briefcase",
          "title": "2 Years' Sales Experience",
          "text": ""
        },
        {
          "icon": "fa-chart-line",
          "title": "Base Pay Plus Uncapped Commission",
          "text": ""
        }
      ]
    },
    {
      "type": "bullet-columns",
      "tight": true,
      "lists": [
        {
          "heading": "Job Description",
          "items": [
            "Close warm leads by taking qualified prospects from first call through to a signed deal.",
            "Keep a clear pipeline: record every lead, follow up on proposals and report on deals closed.",
            "Work to a monthly sales target."
          ]
        },
        {
          "heading": "Requirements",
          "items": [
            "2 years' experience closing sales, with a proven record of closed deals.",
            "Strong communicator, confident on calls and in conversations with business owners.",
            "Comfortable using software and a CRM to track your leads."
          ]
        },
        {
          "heading": "Benefits",
          "items": [
            "Remote working arrangement.",
            "Uncapped commission on every deal you close.",
            "Other statutory benefits."
          ]
        }
      ]
    },
    {
      "type": "form",
      "id": "apply-form",
      "tight": true,
      "heading": "Application Form",
      "sub": "Please fill in every field. Your CV must be uploaded as a PDF file.",
      "notice": "DO NOT APPLY MORE THAN ONCE. DOUBLE APPLICATIONS WILL BE DISQUALIFIED",
      "form_id": "applyForm",
      "form_max_width": "720px",
      "button": "Submit Application",
      "success_message": "Thank you for your application. We will reach out to qualified candidates.",
      "fields": [
        {
          "name": "fullName",
          "placeholder": "Full Name",
          "input_type": "text",
          "required": true,
          "minlength": 2
        },
        {
          "name": "gender",
          "placeholder": "Gender",
          "input_type": "select",
          "required": true,
          "options": [
            "Male",
            "Female"
          ]
        },
        {
          "name": "phone",
          "placeholder": "Phone Number (with country code), e.g. +234 805 203 3145",
          "input_type": "tel",
          "required": true,
          "pattern": "^[0-9+\\s()-]{7,}$",
          "title": "Enter a valid phone number"
        },
        {
          "name": "location",
          "placeholder": "State of Residence (Nigeria)",
          "input_type": "select",
          "required": true,
          "options": [
            "Abia",
            "Adamawa",
            "Akwa Ibom",
            "Anambra",
            "Bauchi",
            "Bayelsa",
            "Benue",
            "Borno",
            "Cross River",
            "Delta",
            "Ebonyi",
            "Edo",
            "Ekiti",
            "Enugu",
            "FCT (Abuja)",
            "Gombe",
            "Imo",
            "Jigawa",
            "Kaduna",
            "Kano",
            "Katsina",
            "Kebbi",
            "Kogi",
            "Kwara",
            "Lagos",
            "Nasarawa",
            "Niger",
            "Ogun",
            "Ondo",
            "Osun",
            "Oyo",
            "Plateau",
            "Rivers",
            "Sokoto",
            "Taraba",
            "Yobe",
            "Zamfara"
          ]
        },
        {
          "name": "yearsExperience",
          "placeholder": "Years of Sales Experience",
          "input_type": "select",
          "required": true,
          "options": [
            "2",
            "3",
            "4",
            "5+"
          ]
        },
        {
          "name": "cv",
          "placeholder": "Upload Your CV",
          "input_type": "file",
          "accept": ".pdf,application/pdf",
          "required": true,
          "help": "PDF only, max 5MB."
        }
      ]
    }
  ],
  "scripts": [
    "/js/form-guard.js",
    "/js/apply-tech-sales-closer-form.js"
  ]
