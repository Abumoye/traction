      ]
    }
  ],
  "hero": {
    "back": { "href": "/apply/", "label": "Back to Careers" },
    "eyebrow": "We Are Hiring",
    "headline": "Real Estate Sales Manager",
    "sub": "We are hiring a Real Estate Sales Manager in Kado, Abuja. This is a sales-driven role with a real estate focus. Full-time · ₦450,000/month."
  },
  "sections": [
    {
      "type": "grid",
      "tight": true,
      "columns": 4,
      "style": "icon-list",
      "entries": [
        {
          "icon": "fa-map-marker-alt",
          "title": "Based in Abuja, FCT",
          "text": ""
        },
        {
          "icon": "fa-chart-line",
          "title": "Sales-Driven Role",
          "text": ""
        },
        {
          "icon": "fa-house-user",
          "title": "Real Estate Focus",
          "text": ""
        },
        {
          "icon": "fa-file-upload",
          "title": "CV Required (PDF)",
          "text": ""
        }
      ]
    },
    {
      "type": "form",
      "id": "apply-form",
      "tight": true,
      "heading": "Application Form",
      "sub": "Please fill in every field. Your CV must be uploaded as a PDF file.",
      "notice": "DO NOT APPLY MORE THAN ONCE. DOUBLE APPLICATIONS WILL BE DISQUALIFIED",
      "form_id": "applyForm",
      "form_max_width": "720px",
      "button": "Submit Application",
      "success_message": "Thank you for your application. We will reach out to qualified candidates.",
      "fields": [
        {
          "name": "fullName",
          "placeholder": "Full Name",
          "input_type": "text",
          "required": true,
          "minlength": 2
        },
        {
          "name": "gender",
          "placeholder": "Gender",
          "input_type": "select",
          "required": true,
          "options": ["Male", "Female"]
        },
        {
          "name": "phone",
          "placeholder": "Phone Number (with country code), e.g. +234 805 203 3145",
          "input_type": "tel",
          "required": true,
          "pattern": "^[0-9+\\s()-]{7,}$",
          "title": "Enter a valid phone number"
        },
        {
          "name": "location",
          "placeholder": "Location in Abuja (Area Council)",
          "input_type": "select",
          "required": true,
          "options": ["Abaji", "Abuja Municipal (AMAC)", "Bwari", "Gwagwalada", "Kuje", "Kwali"]
        },
        {
          "name": "yearsExperience",
          "placeholder": "Years of Real Estate Experience",
          "input_type": "select",
          "required": true,
          "options": ["1", "2", "3", "4", "5"]
        },
        {
          "name": "salesExperience",
          "placeholder": "Do You Have Real Estate Sales Experience?",
          "input_type": "select",
          "required": true,
          "options": ["Yes", "No"]
        },
        {
          "name": "cv",
          "placeholder": "Upload Your CV",
          "input_type": "file",
          "accept": ".pdf,application/pdf",
          "required": true,
          "help": "PDF only, max 5MB."
        }
      ]
    }
  ],
  "scripts": ["/js/apply-form.js"]
}
