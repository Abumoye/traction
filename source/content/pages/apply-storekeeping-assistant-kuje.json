          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "cv",
          "placeholder": "Upload Your CV",
          "input_type": "file",
          "accept": ".pdf,application/pdf",
          "required": true,
          "help": "PDF only, max 5MB."
