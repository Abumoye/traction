    {
      "type": "grid",
      "heading": "Where We Deliver",
      "columns": 3,
      "style": "plain",
      "entries": [
        {
          "title": "In Nigeria",
          "text": "Physical classes run in Abuja, Lagos, Enugu, Anambra, Ibadan, Asaba, Kaduna, and Kano. A minimum of 5 participants is required for a physical class within Nigeria."
        },
        {
          "title": "Beyond Nigeria",
          "text": "Physical classes are also available in Kigali (Rwanda), Accra (Ghana), and Nairobi (Kenya), with a minimum of 15 participants for physical classes outside Nigeria."
        },
        {
          "title": "Online",
          "text": "Every course in the catalogue is also available online, with no minimum number of participants, so a single employee or a full team can enrol either way."
        }
      ]
    },
    {
      "type": "grid",
      "heading": "Need Something The Catalogue Doesn't Cover?",
