{
  "_route": {
    "template": "flex.html",
    "output": "events/register/index.html",
    "url": "/events/register/"
  },
  "meta": {
    "title": "Register for T-ICR 2026 | Traction Outsourcing",
    "description": "Register for the Traction Outsourcing International Corporate Retreat 2026 in Kigali, Rwanda, November 22-30. Only 30 Early Bird seats available.",
    "image": "/images/og/og-events.jpg"
  },
  "hero": {
    "eyebrow": "T-ICR 2026",
    "headline": "Register: Kigali Retreat 2026",
    "sub": "November 22nd - 30th, 2026 | Kigali, Rwanda | Only 30 Early Bird seats available"
  },
  "sections": [
    {
      "type": "form",
      "heading": "Retreat Registration",
      "form_id": "eventRegisterForm",
      "button": "Proceed to Payment",
      "fields": [
        {
          "name": "fullName",
          "placeholder": "Full Name",
          "input_type": "text",
          "required": true,
          "minlength": 2
        },
        {
          "name": "phone",
          "placeholder": "Phone Number (with country code), e.g. +234 805 203 3145",
          "input_type": "tel",
          "required": true,
          "pattern": "^[0-9+\\s()-]{7,}$",
          "title": "Enter a valid phone number"
        },
        {
          "name": "email",
          "placeholder": "Email Address",
          "input_type": "email",
          "required": true
        },
        {
          "name": "referral",
          "placeholder": "Referral Code (optional)",
          "input_type": "text",
          "required": false
        }
      ]
    }
  ],
  "scripts": ["/js/event-registration.js"]
}
