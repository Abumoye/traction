          "title": "Enter your age in years, as at 31 October 2026"
        },
        {
          "name": "phone",
          "placeholder": "Phone Number (11 digits), e.g. 08052033145",
          "input_type": "tel",
          "digits": 11,
          "required": true,
          "title": "Enter your 11-digit phone number, numbers only (e.g. 08052033145)"
        },
        {
          "name": "email",
          "placeholder": "Email Address",
          "input_type": "email",
          "required": true,
          "title": "Enter a valid email address"
        },
        {
          "name": "resumeImmediately",
          "placeholder": "Can you resume immediately?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "livesInAbuja",
          "placeholder": "Do you currently live in Abuja?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "productExperience",
          "placeholder": "Do you have experience in product management?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "ecommerceExperience",
          "placeholder": "Do you have e-commerce experience?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "cv",
          "placeholder": "Upload Your CV",
          "input_type": "file",
          "accept": ".pdf,application/pdf",
          "required": true,
          "help": "PDF only, max 5MB."
        }
      ]
