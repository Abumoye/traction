    "eyebrow": "We Are Hiring",
    "headline": "Chef",
    "sub": "We are hiring a Chef for a hotel and apartments company in Wuse 2, Abuja. Full-time · ₦250,000/month."
  },
  "sections": [
    {
      "type": "grid",
      "tight": true,
      "columns": 4,
      "style": "icon-list",
      "entries": [
        {
          "icon": "fa-map-marker-alt",
          "title": "Wuse 2, Abuja, FCT",
          "text": ""
        },
        {
          "icon": "fa-briefcase",
          "title": "Full-Time Role",
          "text": ""
        },
        {
          "icon": "fa-utensils",
          "title": "3 Years' Experience as a Chef",
          "text": ""
        },
        {
          "icon": "fa-hotel",
          "title": "Hotel and Apartments Company",
          "text": ""
        }
      ]
    },
    {
      "type": "bullet-columns",
      "tight": true,
      "lists": [
        {
          "heading": "Job Description",
          "items": [
            "Prepare and cook meals to a consistent standard of quality for hotel and apartment guests.",
            "Plan menus and portions, and suggest new dishes.",
            "Keep the kitchen clean and follow food safety and hygiene standards.",
            "Monitor stock, order ingredients and keep waste low."
          ]
        },
        {
          "heading": "Requirements",
          "items": [
            "3 years' experience as a chef.",
            "Background in a hotel, apartment or restaurant kitchen.",
            "Able to cook Nigerian and continental dishes."
          ]
        },
        {
          "heading": "Benefits",
          "items": [
            "Opportunity to grow with a hospitality company and receive training.",
            "Other statutory benefits."
          ]
        }
      ]
    },
    {
      "type": "form",
      "id": "apply-form",
      "tight": true,
      "heading": "Application Form",
      "sub": "Please fill in every field. Your CV must be uploaded as a PDF file.",
      "notice": "DO NOT APPLY MORE THAN ONCE. DOUBLE APPLICATIONS WILL BE DISQUALIFIED",
      "form_id": "applyForm",
      "form_max_width": "720px",
      "button": "Submit Application",
      "success_message": "Thank you for your application. We will reach out to qualified candidates.",
      "fields": [
        {
          "name": "fullName",
          "placeholder": "Full Name",
          "input_type": "text",
          "required": true,
          "minlength": 2
        },
        {
          "name": "gender",
          "placeholder": "Gender",
          "input_type": "select",
          "required": true,
          "options": [
            "Male",
            "Female"
          ]
        },
        {
          "name": "phone",
          "placeholder": "Phone Number (with country code), e.g. +234 805 203 3145",
          "input_type": "tel",
          "required": true,
          "pattern": "^[0-9+\\s()-]{7,}$",
          "title": "Enter a valid phone number"
        },
        {
          "name": "location",
          "placeholder": "Location in Abuja (Area Council)",
          "input_type": "select",
          "required": true,
          "options": [
            "Abaji",
            "Abuja Municipal (AMAC)",
            "Bwari",
            "Gwagwalada",
            "Kuje",
            "Kwali"
          ]
        },
        {
          "name": "yearsExperience",
          "placeholder": "Years of Experience as a Chef",
          "input_type": "select",
          "required": true,
          "options": [
            "3",
            "4",
            "5",
            "6+"
          ]
        },
        {
          "name": "cv",
          "placeholder": "Upload Your CV",
          "input_type": "file",
          "accept": ".pdf,application/pdf",
          "required": true,
          "help": "PDF only, max 5MB."
        }
      ]
    }
  ],
  "scripts": [
    "/js/form-guard.js",
    "/js/apply-chef-form.js"
  ]
}