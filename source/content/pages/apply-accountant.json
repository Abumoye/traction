{
  "_route": {
    "template": "flex.html",
    "output": "apply/accountant/index.html",
    "url": "/apply/accountant/"
  },
  "meta": {
    "title": "Accountant Job, Abuja | Traction Outsourcing",
    "description": "Accountant job in Abuja at ₦350,000/month. Full-time, 4 years' experience required. B.Sc or HND in Accounting, ICAN or ACCA. Apply online at Traction Outsourcing Limited.",
    "image": "/images/jobs/accountant.jpg",
    "image_height": 630,
    "image_alt": "Smiling man in a navy suit and blue tie beside the Traction Outsourcing logo and an Apply Now button, for the Accountant job"
  },
  "schema": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://tolnigeria.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Careers",
          "item": "https://tolnigeria.com/apply/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Accountant",
          "item": "https://tolnigeria.com/apply/accountant/"
        }
      ]
    }
  ],
  "hero": {
    "back": {
      "href": "/apply/",
      "label": "Back to Careers"
    },
    "eyebrow": "We Are Hiring",
    "headline": "Accountant",
    "sub": "We are hiring an Accountant in Abuja. Full-time · ₦350,000/month."
  },
  "sections": [
    {
      "type": "grid",
      "tight": true,
      "columns": 4,
      "style": "icon-list",
      "entries": [
        {
          "icon": "fa-map-marker-alt",
          "title": "Onsite in Abuja, FCT",
          "text": ""
        },
        {
          "icon": "fa-briefcase",
          "title": "Full-Time Role",
          "text": ""
        },
        {
          "icon": "fa-calculator",
          "title": "4 Years' Experience in Accounting",
          "text": ""
        },
        {
          "icon": "fa-file-upload",
          "title": "CV Required (PDF)",
          "text": ""
        }
      ]
    },
    {
      "type": "bullet-columns",
      "tight": true,
      "lists": [
        {
          "heading": "Job Description",
          "items": [
            "Keep accurate books of account and prepare regular ledger and bank reconciliations.",
            "Prepare and file tax and other statutory returns on time.",
            "Prepare monthly financial reports for management."
          ]
        },
        {
          "heading": "Requirements",
          "items": [
            "B.Sc or HND in Accounting, Finance or a related field.",
            "ICAN or ACCA (certified or part-qualified).",
            "4 years' experience in accounting, with working knowledge of Nigerian tax rules."
          ]
        },
        {
          "heading": "Benefits",
          "items": [
            "Professional development support.",
            "Performance bonus.",
            "Other statutory benefits."
          ]
        }
      ]
    },
    {
      "type": "form",
      "id": "apply-form",
      "tight": true,
      "heading": "Application Form",
      "sub": "Please fill in every field. Your CV must be uploaded as a PDF file.",
      "notice": "DO NOT APPLY MORE THAN ONCE. DOUBLE APPLICATIONS WILL BE DISQUALIFIED",
      "form_id": "applyForm",
      "form_max_width": "720px",
      "button": "Submit Application",
      "success_message": "Thank you for your application. We will reach out to qualified candidates.",
      "fields": [
        {
          "name": "fullName",
          "placeholder": "Full Name",
          "input_type": "text",
          "required": true,
          "minlength": 2
        },
        {
          "name": "gender",
          "placeholder": "Gender",
          "input_type": "select",
          "required": true,
          "options": [
            "Male",
            "Female"
          ]
        },
        {
          "name": "phone",
          "placeholder": "Phone Number (with country code), e.g. +234 805 203 3145",
          "input_type": "tel",
          "required": true,
          "pattern": "^[0-9+\\s()-]{7,}$",
          "title": "Enter a valid phone number"
        },
        {
          "name": "location",
          "placeholder": "Location in Abuja (Area Council)",
          "input_type": "select",
          "required": true,
          "options": [
            "Abaji",
            "Abuja Municipal (AMAC)",
            "Bwari",
            "Gwagwalada",
            "Kuje",
            "Kwali"
          ]
        },
        {
          "name": "yearsExperience",
          "placeholder": "Years of Accounting Experience",
          "input_type": "select",
          "required": true,
          "options": [
            "4",
            "5",
            "6",
            "7+"
          ]
        },
        {
          "name": "cv",
          "placeholder": "Upload Your CV",
          "input_type": "file",
          "accept": ".pdf,application/pdf",
          "required": true,
          "help": "PDF only, max 5MB."
        }
      ]
    }
  ],
  "scripts": [
    "/js/form-guard.js",
    "/js/apply-accountant-form.js"
  ]
}