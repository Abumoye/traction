    "description": "Accountant job in Gwarimpa, Abuja at ₦400,000 - ₦600,000/month. Full-time, 5 to 8 years' experience. Apply online at Traction Outsourcing Limited.",
    "image": "/images/jobs/accountant.jpg",
    "image_height": 630,
    "image_alt": "Smiling man in a navy suit and blue tie beside the Traction Outsourcing logo and an Apply Now button, for the Accountant job"
  },
  "schema": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://tolnigeria.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Careers",
          "item": "https://tolnigeria.com/apply/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Accountant",
          "item": "https://tolnigeria.com/apply/accountant/"
        }
      ]
    }
  ],
  "hero": {
    "back": {
      "href": "/apply/",
      "label": "Back to Careers"
    },
    "eyebrow": "We Are Hiring",
    "headline": "Accountant",
    "sub": "We are hiring an Accountant in Gwarimpa, Abuja. Full-time · ₦400,000 - ₦600,000/month."
  },
  "sections": [
    {
      "type": "grid",
      "tight": true,
      "columns": 4,
      "style": "icon-list",
      "entries": [
        {
          "icon": "fa-map-marker-alt",
          "title": "Onsite in Gwarimpa, Abuja",
          "text": ""
        },
        {
          "icon": "fa-briefcase",
          "title": "Full-Time Role",
          "text": ""
        },
        {
          "icon": "fa-calculator",
          "title": "5 to 8 Years' Experience in Accounting",
          "text": ""
        },
        {
          "icon": "fa-file-upload",
          "title": "CV Required (PDF)",
          "text": ""
        }
      ]
    },
    {
      "type": "bullet-columns",
      "tight": true,
      "lists": [
        {
          "heading": "Job Description",
          "items": [
            "Keep accurate books of account and prepare regular ledger and bank reconciliations.",
            "Prepare and file tax and other statutory returns on time.",
            "Prepare monthly financial reports for management."
          ]
        },
        {
          "heading": "Requirements",
          "items": [
            "B.Sc or HND in Accounting, Finance or a related field.",
            "ICAN or ACCA (certified or part-qualified).",
            "5 to 8 years' experience in accounting, with working knowledge of Nigerian tax rules."
          ]
        },
        {
          "heading": "Benefits",
          "items": [
            "Professional development support.",
            "Performance bonus.",
            "Other statutory benefits."
          ]
        }
      ]
    },
    {
      "type": "form",
      "id": "apply-form",
      "tight": true,
      "heading": "Application Form",
      "sub": "Please fill in every field. Your CV must be uploaded as a PDF file.",
      "notice": "DO NOT APPLY MORE THAN ONCE. DOUBLE APPLICATIONS WILL BE DISQUALIFIED",
      "form_id": "applyForm",
      "form_max_width": "720px",
      "button": "Submit Application",
      "success_message": "Thank you for your application. We will reach out to qualified candidates.",
      "fields": [
        {
          "name": "fullName",
          "placeholder": "Full Name",
          "input_type": "text",
          "required": true,
          "minlength": 2
        },
        {
          "name": "gender",
          "placeholder": "Gender",
          "input_type": "select",
          "required": true,
          "options": [
            "Male",
            "Female"
          ]
        },
        {
          "name": "age",
          "placeholder": "Age (as at 31 October 2026)",
          "input_type": "number",
          "required": true,
          "min": 16,
          "max": 70,
          "title": "Enter your age in years, as at 31 October 2026"
        },
        {
          "name": "phone",
          "placeholder": "Phone Number (11 digits), e.g. 08052033145",
          "input_type": "tel",
          "digits": 11,
          "required": true,
          "title": "Enter your 11-digit phone number, numbers only (e.g. 08052033145)"
        },
        {
          "name": "email",
          "placeholder": "Email Address",
          "input_type": "email",
          "required": true,
          "title": "Enter a valid email address"
        },
        {
          "name": "resumeImmediately",
          "placeholder": "Can you resume immediately?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "livesInAbuja",
          "placeholder": "Do you currently live in Abuja?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "icanCertified",
          "placeholder": "Are you ICAN certified?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "yearsExperience",
          "placeholder": "Total years of experience (post NYSC)",
          "input_type": "select",
          "required": true,
          "options": [
            "5",
            "6",
            "7",
            "8",
            "9",
            "10",
            "11",
            "12"
          ]
        },
        {
          "name": "cv",
          "placeholder": "Upload Your CV",
          "input_type": "file",
          "accept": ".pdf,application/pdf",
          "required": true,
          "help": "PDF only, max 5MB."
        }
      ]
    }
  ],
  "scripts": [
    "/js/form-guard.js",
    "/js/apply-fields.js",
    "/js/apply-accountant-form.js"
  ]
}