    "url": "/apply/sales-assistant/"
  },
  "meta": {
    "title": "Sales Assistant Job, Wuse 2, Abuja | Traction Outsourcing",
    "description": "Sales Assistant job in Wuse 2, Abuja at ₦100,000/month. Full-time role with a clothing store. 1-2 years' experience required. Apply online at Traction Outsourcing Limited.",
    "image": "/images/jobs/sales-assistant.jpg",
    "image_height": 630,
    "image_alt": "Smiling woman in an orange blazer beside the Traction Outsourcing logo and an Apply Now button, for the Sales Assistant job"
  },
  "schema": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://tolnigeria.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Careers",
          "item": "https://tolnigeria.com/apply/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Sales Assistant",
          "item": "https://tolnigeria.com/apply/sales-assistant/"
        }
      ]
    }
  ],
  "hero": {
    "back": {
      "href": "/apply/",
      "label": "Back to Careers"
    },
    "eyebrow": "We Are Hiring",
    "headline": "Sales Assistant",
    "sub": "We are hiring a Sales Assistant for a clothing store in Wuse 2, Abuja. Full-time · ₦100,000/month."
  },
  "sections": [
    {
      "type": "grid",
      "tight": true,
      "columns": 4,
      "style": "icon-list",
      "entries": [
        {
          "icon": "fa-map-marker-alt",
          "title": "Wuse 2, Abuja, FCT",
          "text": ""
        },
        {
          "icon": "fa-briefcase",
          "title": "Full-Time Role",
          "text": ""
        },
        {
          "icon": "fa-user-clock",
          "title": "1-2 Years' Experience",
          "text": ""
        },
        {
          "icon": "fa-shirt",
          "title": "Clothing Store",
          "text": ""
        }
      ]
    },
    {
      "type": "bullet-columns",
      "tight": true,
      "lists": [
        {
          "heading": "Job Description",
          "items": [
            "Welcome customers, understand what they are looking for and help them choose the right clothing and fabrics.",
            "Handle, fold and display fabrics and clothing with care, and keep the shop floor tidy.",
            "Keep the store presentable and report stock and customer requests to the store management."
          ]
        },
        {
          "heading": "Requirements",
          "items": [
            "1-2 years' experience in sales or retail.",
            "Good communication skills.",
            "Presentable and comfortable handling fabrics.",
            "Able to commute to Wuse 2, Abuja and resume immediately."
          ]
        },
        {
          "heading": "Benefits",
          "items": [
            "Other statutory benefits."
          ]
        }
      ]
    },
    {
      "type": "form",
      "id": "apply-form",
      "tight": true,
      "heading": "Application Form",
      "sub": "Please fill in every field. Your CV must be uploaded as a PDF file.",
      "notice": "DO NOT APPLY MORE THAN ONCE. DOUBLE APPLICATIONS WILL BE DISQUALIFIED",
      "form_id": "applyForm",
      "form_max_width": "720px",
      "button": "Submit Application",
      "success_message": "Thank you for your application. We will reach out to qualified candidates.",
      "fields": [
        {
          "name": "fullName",
          "placeholder": "Full Name",
          "input_type": "text",
          "required": true,
          "minlength": 2
        },
        {
          "name": "gender",
          "placeholder": "Gender",
          "input_type": "select",
          "required": true,
          "options": [
            "Male",
            "Female"
          ]
        },
        {
          "name": "age",
          "placeholder": "Age (as at 31 October 2026)",
          "input_type": "number",
          "required": true,
          "min": 16,
          "max": 70,
          "title": "Enter your age in years, as at 31 October 2026"
        },
        {
          "name": "phone",
          "placeholder": "Phone Number (11 digits), e.g. 08052033145",
          "input_type": "tel",
          "digits": 11,
          "required": true,
          "title": "Enter your 11-digit phone number, numbers only (e.g. 08052033145)"
        },
        {
          "name": "email",
          "placeholder": "Email Address",
          "input_type": "email",
          "required": true,
          "title": "Enter a valid email address"
        },
        {
          "name": "resumeImmediately",
          "placeholder": "Can you resume immediately?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "livesInAbuja",
          "placeholder": "Do you currently live in Abuja?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "speaksHausa",
          "placeholder": "Do you speak Hausa?",
          "input_type": "select",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "cv",
          "placeholder": "Upload Your CV",
          "input_type": "file",
          "accept": ".pdf,application/pdf",
          "required": true,
          "help": "PDF only, max 5MB."
        }
      ]
    }
  ],
  "scripts": [
    "/js/form-guard.js",
    "/js/apply-fields.js",
    "/js/apply-sales-assistant-form.js"
  ]
}
